TELEGRAM_BOT_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_NAME=小椰
FEISHU_PROJECT_FOLDER_TOKEN=
FEISHU_DOC_BASE_URL=https://www.feishu.cn

# Optional Bocha Web Search for Feishu search result cards.
WEB_SEARCH_ENABLED=false
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_COUNT=6
BOCHA_SEARCH_FRESHNESS=noLimit
BOCHA_SEARCH_SUMMARY=true
BOCHA_SEARCH_TIMEOUT_MS=30000
WEB_SEARCH_SUMMARY_MAX_TOKENS=700
AI_API_KEY=

# Primary chat/reply model. Use either a full endpoint or a base URL.
# AI_URL=https://api.example.com/v1/chat/completions
# AI_URL=https://api.example.com/v1
AI_URL=
AI_MODEL=gpt-5.5
AI_COMPATIBILITY=openai
# Optional for providers with different request-body fields.
AI_MAX_TOKENS_FIELD=
AI_EXTRA_BODY_JSON=
AI_REPLY_MAX_TOKENS=900
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MS=800

# Optional fallback chat/reply model. This is used only when the primary model fails.
FALLBACK_AI_API_KEY=
FALLBACK_AI_URL=https://api.minimaxi.com/v1/chat/completions
FALLBACK_AI_MODEL=MiniMax-M3
FALLBACK_AI_COMPATIBILITY=minimax
FALLBACK_AI_MAX_TOKENS_FIELD=
FALLBACK_AI_EXTRA_BODY_JSON=

# Optional image generation API. Use a base URL or full /v1/images/generations endpoint.
IMAGE_GENERATION_ENABLED=true
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_MS=600000
IMAGE_RETRY_ATTEMPTS=3
IMAGE_UNDERSTANDING_REQUIRE_PRIMARY=false

# Optional speech-to-text API for Telegram voice messages.
# Recommended free/fast option: Groq OpenAI-compatible transcriptions.
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_ENABLED=false
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=zh
STT_PROMPT=

# Only enable this if your main chat model truly supports input_audio.
VOICE_DIRECT_INPUT_ENABLED=false

# Optional text-to-speech for Telegram bot replies.
# MOSI docs: https://studio.mosi.cn/docs/models/moss-tts
TTS_ENABLED=false
TTS_API_URL=https://studio.mosi.cn/api/v1/audio/speech
TTS_API_KEY=
TTS_MODEL=moss-tts
TTS_VOICE_ID=
TTS_MAX_INPUT_CHARS=1200
TTS_TIMEOUT_MS=1800000
TTS_TELEGRAM_MODE=voice
TTS_META_INFO=false
FEISHU_TTS_VOICE_ID=
FEISHU_TTS_MAX_INPUT_CHARS=1200

# Optional song lookup API for Feishu voice replies. Keep the token server-side.
SONG_API_ENABLED=false
SONG_API_URL=https://api.suol.cc/v1/yy_sq.php
SONG_API_TOKEN=
SONG_API_SOURCE=qq
SONG_DEFAULT_QUERIES=邓紫棋 光年之外,邓紫棋 泡沫,邓紫棋 句号,邓紫棋 喜欢你,邓紫棋 倒数,邓紫棋 多远都要在一起,邓紫棋 来自天堂的魔鬼
SONG_SEARCH_ATTEMPTS=3
SONG_MAX_DOWNLOAD_BYTES=83886080

# Optional remote video inventory for Feishu media replies.
VIDEO_LIBRARY_ENABLED=true
VIDEO_LIBRARY_URL=https://szygumin.icu/xiaoye-media/library.json
VIDEO_LIBRARY_TRIGGER_HINTS=清唱,发视频,来段视频,视频
VIDEO_LIBRARY_TIMEOUT_MS=8000
VIDEO_LIBRARY_CACHE_MS=300000
VIDEO_LIBRARY_DOWNLOAD_TIMEOUT_MS=120000
VIDEO_LIBRARY_MAX_BYTES=31457280

# Render Postgres will provide this if you add a Postgres database service.
DATABASE_URL=
DB_SSL=false

BOT_DISPLAY_NAME=小椰
COMPANION_MODE=girlfriend
BOT_LANGUAGE=zh-CN
SELF_REFERENCE_IMAGE_PATH=assets/persona/xiaoye-reference.jpg
SELF_APPEARANCE_DESCRIPTION=小椰的固定形象：年轻温柔的东亚女性，长深棕色自然微卷发，干净明亮的眼睛，柔和自然的微笑，清爽亲切的气质。整体感觉阳光、干净、温柔，常穿简洁的白色宽松上衣，照片风格真实自然、生活感强。
SELF_SELFIE_STYLE=真实手机自拍风格，自然光，轻微景深，画面干净，不要夸张滤镜，不要文字、水印、logo，不要多人合照。

# private chats always reply. Groups require mention/command by default.
# mention: reply only when @bot, /ai, /ask, /love, or replying to the bot.
# smart: record normal group messages and use the AI service to decide when to reply.
# all: reply to every non-command group message. Use carefully.
TRIGGER_MODE=mention
SMART_CLASSIFIER_ENABLED=false

# Protect /admin on public hosting. Locally, /admin is allowed without a password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: back up memory to a private GitHub repo branch.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=memory-backups
GITHUB_BACKUP_PATH=backups/render-memory.json
GITHUB_BACKUP_INTERVAL_MINUTES=30
RESTORE_MEMORY_FROM_GITHUB=true

# Optional comma-separated allowlists. Leave empty while testing.
ALLOWED_CHAT_IDS=
BOT_OWNER_IDS=

AUTO_MEMORY=true
RECENT_MESSAGE_LIMIT=24
MEMORY_LIMIT=24
MAX_REPLY_CHARS=3600
PORT=3000
