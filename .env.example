TELEGRAM_BOT_TOKEN=
AI_API_KEY=

# Primary chat/reply model. Use either a full endpoint or a base URL.
# AI_URL=https://api.example.com/v1/chat/completions
# AI_URL=https://api.example.com/v1
AI_URL=
AI_MODEL=gpt-5.5
AI_COMPATIBILITY=openai
# Optional for providers with different request-body fields.
AI_MAX_TOKENS_FIELD=
AI_EXTRA_BODY_JSON=
AI_REPLY_MAX_TOKENS=900

# Optional fallback chat/reply model. This is used only when the primary model fails.
FALLBACK_AI_API_KEY=
FALLBACK_AI_URL=https://api.minimaxi.com/v1/chat/completions
FALLBACK_AI_MODEL=MiniMax-M3
FALLBACK_AI_COMPATIBILITY=minimax
FALLBACK_AI_MAX_TOKENS_FIELD=
FALLBACK_AI_EXTRA_BODY_JSON=

# Optional image generation API. Use a base URL or full /v1/images/generations endpoint.
IMAGE_GENERATION_ENABLED=true
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024

# Optional speech-to-text API for Telegram voice messages.
# Recommended free/fast option: Groq OpenAI-compatible transcriptions.
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_ENABLED=false
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=zh
STT_PROMPT=

# Only enable this if your main chat model truly supports input_audio.
VOICE_DIRECT_INPUT_ENABLED=false

# Render Postgres will provide this if you add a Postgres database service.
DATABASE_URL=
DB_SSL=false

BOT_DISPLAY_NAME=小伴
COMPANION_MODE=girlfriend
BOT_LANGUAGE=zh-CN

# private chats always reply. Groups require mention/command by default.
# mention: reply only when @bot, /ai, /ask, /love, or replying to the bot.
# smart: record normal group messages and use the AI service to decide when to reply.
# all: reply to every non-command group message. Use carefully.
TRIGGER_MODE=mention
SMART_CLASSIFIER_ENABLED=false

# Protect /admin on public hosting. Locally, /admin is allowed without a password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: back up memory to a private GitHub repo branch.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=memory-backups
GITHUB_BACKUP_PATH=backups/render-memory.json
GITHUB_BACKUP_INTERVAL_MINUTES=30
RESTORE_MEMORY_FROM_GITHUB=true

# Optional comma-separated allowlists. Leave empty while testing.
ALLOWED_CHAT_IDS=
BOT_OWNER_IDS=

AUTO_MEMORY=true
RECENT_MESSAGE_LIMIT=24
MEMORY_LIMIT=24
MAX_REPLY_CHARS=3600
PORT=3000
