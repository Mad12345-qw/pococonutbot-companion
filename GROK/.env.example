PORT=3000
SERVICE_NAME=feishu-grok-bridge

FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Grok CLI credentials. Render restores auth.json from GROK_AUTH_JSON_B64.
GROK_DEPLOYMENT_KEY=
GROK_AUTH_JSON_B64=
GROK_CLI_ENABLED=true
GROK_CLI_TIMEOUT_MS=540000
GROK_CLI_COMMAND=grok
GROK_CLI_CWD=
GROK_MEDIA_MAX_TURNS=24
GROK_CLI_ARGS_JSON=["--no-auto-update","--always-approve","--permission-mode","bypassPermissions","--max-turns","20","--cwd","{{cwd}}","--no-memory","--output-format","streaming-json","-p","{{prompt}}"]

MAX_CARD_CONTENT_CHARS=90000
MAX_REPLY_CHARS=3500
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=31457280
DEBUG_TOKEN=
