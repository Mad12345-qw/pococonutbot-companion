PORT=3000
SERVICE_NAME=feishu-grok-bridge

FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Preferred for reliable web search.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_TIMEOUT_MS=540000

# Optional CLI fallback. Render needs a deployment key, not local browser login.
GROK_DEPLOYMENT_KEY=
GROK_AUTH_JSON_B64=
GROK_CLI_ENABLED=true
GROK_CLI_TIMEOUT_MS=300000
GROK_CLI_COMMAND=grok
GROK_CLI_CWD=
GROK_CLI_ARGS_JSON=["--cwd","{{cwd}}","--no-memory","--no-plan","--max-turns","1","--output-format","plain","-p","{{prompt}}"]

SEND_PROGRESS_MESSAGE=true
MAX_REPLY_CHARS=3500
DEBUG_TOKEN=
